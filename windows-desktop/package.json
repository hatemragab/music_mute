{
  "name": "musicmute-windows-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts",
    "format": "prettier --write src tests scripts docs README.md package.json tsconfig.json vitest.config.ts",
    "format:check": "prettier --check src tests scripts docs README.md package.json tsconfig.json vitest.config.ts",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts.test.ts tests/security.test.ts tests/host-support.test.ts",
    "test:package-fixtures": "node --test scripts/build-boundaries.test.mjs scripts/native-check.test.mjs scripts/agent-build-inputs.test.mjs",
    "build:native": "node scripts/native-check.mjs build",
    "test:native": "node scripts/native-check.mjs test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:package-fixtures && npm run build && npm run format:check",
    "build:debug": "node scripts/build.mjs --local-debug"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/yauzl": "3.4.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "oxlint": "1.58.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
