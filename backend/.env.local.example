APP_ENV=local
AUDIO_PROCESSING_ENABLED=false
APP_UPDATES_ENABLED=false
APP_RELEASE_DOWNLOAD_SECONDS=300
# Maintained release floors; update these with the shipped mobile app versions.
APP_ANDROID_CURRENT_VERSION_NAME=0.1.0
APP_ANDROID_CURRENT_BUILD_NUMBER=1
APP_IOS_CURRENT_VERSION_NAME=0.1.0
APP_IOS_CURRENT_BUILD_NUMBER=1
# IOS_APP_STORE_ID: configure the real numeric store ID before iOS drafts.
# RELEASE_LANDING_BASE_URL: stable HTTPS origin for direct update landing pages.
PROCESSING_URL_SECONDS=900
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/musicmute
REDIS_URL=redis://127.0.0.1:6379/0
AWS_REGION=us-east-1
S3_BUCKET=musicmute-local
# Optional until worker enrollment artifacts are published to the private bucket.
# WORKER_INSTALLATION_CATALOG_PATH=/absolute/path/to/worker-installation-catalog.json
# AWS credentials resolve from your local profile or standard AWS environment.
FIREBASE_PROJECT_ID=demo-musicmute
FIREBASE_WEB_API_KEY=demo-local-web-api-key
RATE_LIMIT_HASH_SECRET=local-development-only-secret-change-me
# Optional external Application Default Credentials path:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
# Empty list disables browser cross-origin access; native mobile is unaffected.
CORS_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT=60
RATE_TTL_MS=60000
AUTH_UID_PER_MINUTE=120
PROFILE_UID_PER_MINUTE=5
PROFILE_IP_PER_MINUTE=10
DEVICE_UID_PER_MINUTE=10
LOGOUT_UID_PER_HOUR=3
PROCESSING_CREATE_UID_PER_MINUTE=30
PROCESSING_GRANT_UID_PER_MINUTE=60
PROCESSING_MUTATION_UID_PER_MINUTE=60
VERIFY_COOLDOWN_SECONDS=60
VERIFY_UID_PER_DAY=3
VERIFY_EMAIL_PER_DAY=3
VERIFY_IP_PER_HOUR=10
VERIFY_PROJECT_PER_DAY=200
RESET_COOLDOWN_SECONDS=60
RESET_EMAIL_PER_DAY=3
RESET_IP_PER_HOUR=5
RESET_PROJECT_PER_DAY=50
ADMIN_READS_PER_MINUTE=120
ADMIN_WRITES_PER_MINUTE=30
ADMIN_MEDIA_GRANTS_PER_MINUTE=20
ADMIN_SENSITIVE_OPERATIONS_PER_MINUTE=5
ADMIN_EXPORTS_PER_HOUR=5
ADMIN_REAUTH_MAX_AGE_SECONDS=300
BODY_LIMIT_BYTES=65536
# Public account/privacy pages return 503 until all four approved values are configured.
# PUBLIC_SUPPORT_EMAIL=
# PUBLIC_DEVELOPER_NAME=
# PUBLIC_DELETION_TIMEFRAME=
# PUBLIC_RETENTION_NOTICE=
# APK verification fails closed until trusted local tools, package and signer are configured.
# APK_AAPT2_PATH=/absolute/path/to/aapt2
# APK_APKSIGNER_PATH=/absolute/path/to/apksigner
# APK_EXPECTED_PACKAGE_ID=com.example.application
# APK_TRUSTED_SIGNER_SHA256=approved-lowercase-certificate-sha256-hex
# APK_MAX_MIN_SDK=26
