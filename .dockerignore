# Only backend build inputs may enter the Docker build context.
*
!backend/
backend/*
!backend/package.json
!backend/pnpm-lock.yaml
!backend/.npmrc
!backend/nest-cli.json
!backend/tsconfig*.json
!backend/config/
backend/config/*
!backend/config/worker-installation-catalog.json
!backend/src/
!backend/src/**
backend/src/**/*.spec.ts
