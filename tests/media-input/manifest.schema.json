{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "synthetic", "fixtures"],
  "properties": {
    "schemaVersion": {"const": 1},
    "synthetic": {"const": true},
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "kind", "expected", "actualBytes", "sha256", "measuredDurationSeconds", "streamTypes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "file": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
          "kind": {"enum": ["media", "transport", "invalid"]},
          "expected": {"type": "string"},
          "actualBytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "measuredDurationSeconds": {"type": ["number", "null"], "minimum": 0},
          "streamTypes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
