{
  "name": "@musicmute/worker",
  "version": "0.1.0-mvp.36",
  "private": true,
  "description": "MusicMute machine supervisor and native processing child",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatemragab/music_mute.git",
    "directory": "worker"
  },
  "files": [
    "dist/src/",
    "dist/protocol/",
    "engine/musicmute_engine/*.py",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.14.0",
  "bin": {
    "mw": "./dist/src/cli/main.js"
  },
  "scripts": {
    "protocol:sync": "node scripts/sync-protocol.mjs",
    "protocol:check": "node scripts/sync-protocol.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src/ tests/ protocol/ scripts/",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:engine": "node scripts/run-engine-tests.mjs",
    "verify": "pnpm run protocol:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run test:engine && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2",
    "ws": "^8.21.3"
  }
}
