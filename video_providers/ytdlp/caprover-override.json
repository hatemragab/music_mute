{
  "TaskTemplate": {
    "ContainerSpec": {
      "Init": true,
      "ReadOnly": true,
      "CapabilityDrop": ["ALL"],
      "Mounts": [
        {
          "Type": "tmpfs",
          "Target": "/work",
          "TmpfsOptions": { "SizeBytes": 2147483648, "Mode": 1023 }
        }
      ]
    },
    "Resources": {
      "Limits": { "NanoCPUs": 2000000000, "MemoryBytes": 4294967296 }
    },
    "LogDriver": {
      "Name": "json-file",
      "Options": { "max-size": "5m", "max-file": "2" }
    }
  }
}
