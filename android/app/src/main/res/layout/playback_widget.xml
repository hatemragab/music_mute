<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_art" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_vocal" android:contentDescription="@string/app_name" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="8dp"
            android:paddingEnd="4dp" android:textSize="16sp" android:textColor="#FFFFFF"
            android:maxLines="2" android:ellipsize="end" android:text="@string/listen_widget_empty" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
        <Button android:id="@+id/widget_toggle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/creative_library_play" />
        <Button android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/creative_library_next" />
    </LinearLayout>
    <Button android:id="@+id/widget_import" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/listen_import_audio" />
</LinearLayout>
